{
  "rules": {
    "rooms": {
      "$room": {
        "players": {
          ".read": "auth != null && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/)",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/)",
            ".validate": "newData.hasChildren(['name', 'look', 'x', 'y'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "look": {
              "species": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "expression": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "hat": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "clothes": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "glasses": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "neck": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "held": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "$other": { ".validate": false }
            },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2800" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1900" },
            "emo": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "lc": { ".validate": "newData.isNumber() && (newData.val() === data.val() || (newData.val() === now && (!data.exists() || data.val() <= now - 1500)))" },
            "$other": { ".validate": false }
          }
        },
        "chat": {
          ".read": "auth != null && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/)",
          ".indexOn": ["t"],
          "$msg": {
            ".write": "auth != null && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && data.child('t').val() < now - 600000))",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.parent().parent().child('players').child(auth.uid).child('lc').val() === now",
            "uid": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
            "t": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "party": {
          "current": {
            ".read": "auth != null && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/)",
            ".write": "auth != null && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/) && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (!data.exists() || data.child('meta').child('t').val() < now - 45000) && (!newData.exists() || (newData.child('meta').child('host').val() === auth.uid && newData.child('meta').child('t').val() === now && !newData.child('players').exists() && !newData.child('claims').exists()))",
            ".validate": "newData.hasChildren(['meta'])",
            "meta": {
              ".validate": "newData.hasChildren(['id','host', 'name', 'kind', 'seed', 't'])",
              "host": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
              },
              "kind": {
                ".validate": "newData.val() === 'seeds' || newData.val() === 'race' || newData.val() === 'statue'"
              },
              "seed": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 === 0"
              },
              "t": {
                ".validate": "newData.isNumber() && (newData.val() === data.val() || newData.val() === now)"
              },
              "$other": {
                ".validate": false
              },
              "id": {
                ".validate": "newData.isString() && newData.val().length === 36"
              }
            },
            "players": {
              "$uid": {
                ".write": "newData.exists() && (auth != null && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/) && auth.uid === $uid && ((root.child('rooms').child($room).child('players').child(auth.uid).exists() && ((!data.exists() && now < data.parent().parent().child('meta').child('t').val() + 10000) || (data.exists() && now <= data.parent().parent().child('meta').child('t').val() + 36500))) || (data.exists() && newData.exists() && newData.child('active').val() === false && newData.child('name').val() === data.child('name').val() && newData.child('score').val() === data.child('score').val() && newData.child('done').val() === data.child('done').val() && newData.child('x').val() === data.child('x').val() && newData.child('y').val() === data.child('y').val())))",
                ".validate": "newData.hasChildren(['name','look','x','y','score','done','active'])",
                "name": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12 && (!data.exists() || newData.val() === data.val())"
                },
                "look": {
                  "species": {
                    ".validate": "newData.isString() && newData.val().length <= 24 && (!data.exists() || newData.val() === data.val())"
                  },
                  "expression": {
                    ".validate": "newData.isString() && newData.val().length <= 24 && (!data.exists() || newData.val() === data.val())"
                  },
                  "hat": {
                    ".validate": "newData.isString() && newData.val().length <= 24 && (!data.exists() || newData.val() === data.val())"
                  },
                  "clothes": {
                    ".validate": "newData.isString() && newData.val().length <= 24 && (!data.exists() || newData.val() === data.val())"
                  },
                  "glasses": {
                    ".validate": "newData.isString() && newData.val().length <= 24 && (!data.exists() || newData.val() === data.val())"
                  },
                  "neck": {
                    ".validate": "newData.isString() && newData.val().length <= 24 && (!data.exists() || newData.val() === data.val())"
                  },
                  "held": {
                    ".validate": "newData.isString() && newData.val().length <= 24 && (!data.exists() || newData.val() === data.val())"
                  },
                  ".validate": "newData.hasChildren(['species','expression','hat','clothes','glasses','neck','held'])",
                  "$other": {
                    ".validate": false
                  }
                },
                "active": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                },
                "x": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 === 0"
                },
                "y": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 === 0"
                },
                "score": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0 && (newData.val() === data.val() || newData.val() === 0 || now >= data.parent().parent().parent().child('meta').child('t').val() + 10000)"
                },
                "done": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 25000 && newData.val() % 1 === 0"
                }
              }
            },
            "claims": {
              "$seed": {
                ".write": "auth != null && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/) && root.child('rooms').child($room).child('players').child(auth.uid).exists() && !data.exists() && newData.val() === auth.uid && $seed.matches(/^([0-9]|1[0-9]|2[0-3])$/) && data.parent().parent().child('meta').child('kind').val() === 'seeds' && data.parent().parent().child('players').child(auth.uid).child('active').val() === true && now >= data.parent().parent().child('meta').child('t').val() + 10000 && now < data.parent().parent().child('meta').child('t').val() + 35000",
                ".validate": "newData.isString() && newData.val().length <= 128"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
