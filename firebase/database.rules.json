{
  "rules": {
    "rooms": {
      "$room": {
        "players": {
          ".read": "auth != null && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/)",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/)",
            ".validate": "newData.hasChildren(['name', 'look', 'x', 'y'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "look": {
              "species": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "expression": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "hat": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "clothes": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "glasses": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "neck": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "held": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "$other": { ".validate": false }
            },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2800" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1900" },
            "emo": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "lc": { ".validate": "newData.isNumber() && (newData.val() === data.val() || (newData.val() === now && (!data.exists() || data.val() <= now - 1500)))" },
            "$other": { ".validate": false }
          }
        },
        "chat": {
          ".read": "auth != null && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/)",
          ".indexOn": ["t"],
          "$msg": {
            ".write": "auth != null && $room.matches(/^(pub[1-5]|[A-HJ-NP-Z2-9]{5})$/) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && data.child('t').val() < now - 600000))",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.parent().parent().child('players').child(auth.uid).child('lc').val() === now",
            "uid": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
            "t": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
